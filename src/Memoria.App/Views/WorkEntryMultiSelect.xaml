<UserControl x:Class="Memoria.App.Views.WorkEntryMultiSelect"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root">
 <Grid>
  <ToggleButton x:Name="Toggle" Content="{Binding Summary, ElementName=Root}" Padding="5,3"
                HorizontalContentAlignment="Left" ToolTip="여러 항목을 선택할 수 있습니다."/>
  <Popup IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=Toggle}"
         Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Closed="OnClosed">
   <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="8">
    <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=Root}">
     <ItemsControl.ItemTemplate>
      <DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
       Foreground="{DynamicResource Brush.Foreground}" Margin="3"/></DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
   </Border>
  </Popup>
 </Grid>
</UserControl>
