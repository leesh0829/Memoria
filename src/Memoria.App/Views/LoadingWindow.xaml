<Window x:Class="Memoria.App.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memoria 시작 중"
        Width="360" Height="190"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Background="#FFF8FAFC"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI, Malgun Gothic">
    <Border BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="10"
            Background="#FFF8FAFC" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Width="46" Height="46" HorizontalAlignment="Center">
                <Ellipse Stroke="#FFE2E8F0" StrokeThickness="4" />
                <Ellipse Stroke="#FF6366F1" StrokeThickness="4"
                         StrokeDashArray="1,2.4" StrokeStartLineCap="Round"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotation" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:0.8"
                                                     RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
            </Grid>

            <TextBlock Grid.Row="1" Text="Memoria" FontSize="20" FontWeight="SemiBold"
                       Foreground="#FF111827" HorizontalAlignment="Center" Margin="0,16,0,4" />
            <TextBlock x:Name="StatusText" Grid.Row="2" Text="데이터를 준비하고 있습니다…"
                       FontSize="12" Foreground="#FF64748B" HorizontalAlignment="Center" />
        </Grid>
    </Border>
</Window>
