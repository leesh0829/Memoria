<!-- src/Memoria.App/Views/ChecklistView.xaml -->
<UserControl x:Class="Memoria.App.Views.ChecklistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Memoria.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ChecklistViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Brush.Surface}"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <!-- 항목 한 줄 템플릿(세 섹션 공유). 명령은 AncestorType=ItemsControl → ChecklistViewModel 위임. -->
        <DataTemplate x:Key="ChecklistItemTemplate" DataType="{x:Type vm:ChecklistItemViewModel}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 체크박스: 할 일/후임 작업 표시 -->
                <CheckBox Grid.Column="0"
                          VerticalAlignment="Center" Margin="0,0,8,0"
                          Visibility="{Binding ShowCheckbox, Converter={StaticResource BoolToVis}}"
                          IsChecked="{Binding Done, Mode=OneWay}"
                          Command="{Binding DataContext.ToggleDoneCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}"/>

                <!-- 텍스트: 완료 시 취소선. 입력 박스 없이 밑줄 한 줄로만 구분(#7) -->
                <TextBox Grid.Column="1" VerticalAlignment="Center"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="{DynamicResource Brush.Foreground}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStruck}" Value="True">
                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.StrikethroughForeground}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- 할 일/이슈 고객사 선택. 미분류 선택으로 해제 가능. -->
                <ComboBox Grid.Column="2" Width="140" Margin="8,0,0,0"
                          ItemsSource="{Binding DataContext.ClientChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding ClientSelectionId, Mode=TwoWay}"
                          SelectionChanged="OnClientSelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.Style>
                        <!-- BasedOn으로 전역 콤보 템플릿(다크 테마 팝업/박스)을 상속하고, 미분류 강조만 추가 -->
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnclassified}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.UnclassifiedHighlight}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>

                <!-- 삭제 -->
                <Button Grid.Column="3" Content="🗑" Margin="8,0,0,0" Padding="6,2"
                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
    <DockPanel Margin="12">

        <!-- 헤더: log_date 편집(좌) + Write/Read 전환(우) -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Write" Command="{Binding SetWriteModeCommand}" Padding="10,2" Margin="0,0,4,0"/>
                <Button Content="Read"  Command="{Binding SetReadModeCommand}"  Padding="10,2"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="업무일자:" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.SecondaryForeground}" Margin="0,0,6,0"/>
                <DatePicker SelectedDate="{Binding LogDate, Converter={StaticResource DateOnlyToDateTimeConverter}, Mode=TwoWay}"/>
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding OperationError}"
                   Margin="0,0,0,8" TextWrapping="Wrap"
                   Foreground="#D32F2F">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid>
        <!-- Write 화면 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsReadMode, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel>

                <!-- 할 일 섹션 -->
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="할 일" FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource Brush.Foreground}"/>
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Content="+ 할 일" Command="{Binding AddTaskCommand}" Padding="8,2"/>
                </DockPanel>
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding TasksView}"
                              ItemTemplate="{StaticResource ChecklistItemTemplate}"/>

                <!-- 이슈 섹션 -->
                <DockPanel Margin="0,18,0,4">
                    <TextBlock Text="이슈" FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource Brush.Foreground}"/>
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Content="+ 이슈" Command="{Binding AddIssueCommand}" Padding="8,2"/>
                </DockPanel>
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding IssuesView}"
                              ItemTemplate="{StaticResource ChecklistItemTemplate}"/>

                <!-- 후임 작업: 업무내역에 연동하며 주간보고 집계에서는 제외 -->
                <DockPanel Margin="0,18,0,4">
                    <TextBlock Text="후임 작업 (인수인계)" FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource Brush.Foreground}"/>
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Content="+ 후임 작업" Command="{Binding AddHandoffCommand}" Padding="8,2"/>
                </DockPanel>
                <TextBlock Text="타인이 수행하는 인수인계 업무 · 업무내역 연동 · 주간보고 제외"
                           Foreground="{DynamicResource Brush.SecondaryForeground}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding HandoffsView}"
                              ItemTemplate="{StaticResource ChecklistItemTemplate}"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Read(양식 출력) 화면: 할 일/이슈/후임 작업 -->
        <Grid Visibility="{Binding IsReadMode, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 할 일 출력 -->
            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="할 일" FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource Brush.Foreground}"/>
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="복사"
                            Command="{Binding CopyTaskOutputCommand}" Padding="8,2"/>
                </DockPanel>
                <TextBox Text="{Binding TaskOutput, Mode=OneWay}" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="13"
                         Background="{DynamicResource Brush.EditorBackground}"
                         Foreground="{DynamicResource Brush.Foreground}"
                         BorderBrush="{DynamicResource Brush.Border}"/>
            </DockPanel>

            <!-- 이슈 출력 -->
            <DockPanel Grid.Row="1" Margin="0,6,0,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="이슈" FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource Brush.Foreground}"/>
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="복사"
                            Command="{Binding CopyIssueOutputCommand}" Padding="8,2"/>
                </DockPanel>
                <TextBox Text="{Binding IssueOutput, Mode=OneWay}" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="13"
                         Background="{DynamicResource Brush.EditorBackground}"
                         Foreground="{DynamicResource Brush.Foreground}"
                         BorderBrush="{DynamicResource Brush.Border}"/>
            </DockPanel>

            <DockPanel Grid.Row="2" Margin="0,6,0,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="후임 작업 (인수인계)" FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource Brush.Foreground}"/>
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="복사"
                            Command="{Binding CopyHandoffOutputCommand}" Padding="8,2"/>
                </DockPanel>
                <TextBox Text="{Binding HandoffOutput, Mode=OneWay}" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="13"
                         Background="{DynamicResource Brush.EditorBackground}"
                         Foreground="{DynamicResource Brush.Foreground}"
                         BorderBrush="{DynamicResource Brush.Border}"/>
            </DockPanel>
        </Grid>
        </Grid>
    </DockPanel>
        <Border Panel.ZIndex="10" Background="#55000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="180" Height="5" IsIndeterminate="True" />
                <TextBlock Text="{Binding LoadingMessage}" Margin="0,10,0,0"
                           Foreground="White" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
